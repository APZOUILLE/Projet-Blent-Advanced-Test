# Ce repo se lance depuis bash (WSL, Linux, macOS, Git Bash).
# Les scripts et le Makefile DOIVENT rester en LF : un retour chariot dans un
# shebang donne "/usr/bin/env: 'bash^M': No such file or directory".
* text=auto eol=lf
*.sh     text eol=lf
Makefile text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
